# Copy this file to .env to override the defaults.
# Absolute paths recommended; use forward slashes on Windows, e.g. D:/Videos.
INPUT_DIR=./input
OUTPUT_DIR=./output
FRAMEFORGE_PORT=8765
# On Linux match the owner of your input/output folders (id -u / id -g).
FRAMEFORGE_UID=1000
FRAMEFORGE_GID=1000

# Persistent SQLite presets, SMTP configuration, notification history
DATA_DIR=./data
# Optional email configuration. Blank entries use saved Admin settings.
# Non-empty environment variables override saved settings, including the password.
# Copy this file to .env for Docker; standalone uses process environment variables.
# Booleans: true/false. TLS: starttls (usually 587), ssl (465), none (local relay).
FRAMEFORGE_SMTP_ENABLED=
FRAMEFORGE_SMTP_HOST=
FRAMEFORGE_SMTP_PORT=
FRAMEFORGE_SMTP_TLS=
FRAMEFORGE_SMTP_USERNAME=
FRAMEFORGE_SMTP_PASSWORD=
FRAMEFORGE_SMTP_SENDER=
# Multiple plain email addresses separated by commas.
FRAMEFORGE_SMTP_RECIPIENTS=
FRAMEFORGE_SMTP_ON_FAILURE=
FRAMEFORGE_SMTP_ON_FINISHED=

# Login token required: set a random token (at least 12 characters) on first launch.
# Only its salted hash persists in DATA_DIR. No username or password is used.
FRAMEFORGE_AUTH_TOKEN=
# true when accessing the app through HTTPS; false for loopback HTTP.
FRAMEFORGE_COOKIE_SECURE=false
# Optional comma-separated exact browser origins, e.g. https://frameforge.example.com
# Leave unset for localhost defaults.
# FRAMEFORGE_ORIGINS=
